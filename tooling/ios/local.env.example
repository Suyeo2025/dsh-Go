# Copy to local.env (same folder, never committed) and fill in. tooling/ios/sync-to-mac.sh copies
# it to the Mac. Plain KEY=VALUE lines; values may use $HOME.

# App Store Connect API key: the .p8 lives at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER=00000000-0000-0000-0000-000000000000

# Certificate ids in the developer account (GET /v1/certificates): Apple Distribution for
# TestFlight, Apple Development for the development profile.
DG_CERT_ID=XXXXXXXXXX
DG_DEV_CERT_ID=XXXXXXXXXX

# A dedicated keychain holding the Apple Distribution private key, and a file with its password
# (the login keychain makes codesign wait on a SecurityAgent prompt over ssh).
DG_KC=$HOME/path/to/build.keychain-db
DG_KC_PASS_FILE=$HOME/path/to/keychain.pass

# Internal TestFlight testers (App Store Connect users who can see the app), comma-separated.
DG_TF_TESTERS=tester1@example.com,tester2@example.com

# sim-smoke.sh: a `dsh web` reachable over https, whose launch token is in ~/.dsh/run/stdout.log.
SMOKE_URL=https://dsh.example.com
