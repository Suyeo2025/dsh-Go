// Manual App Store signing overrides, passed via `xcodebuild -xcconfig` by tooling/ios/tf-release.sh.
// -xcconfig applies to every target (including Swift package targets), so the profile is picked
// per target through TARGET_NAME indirection: only Runner gets one, other targets get none.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
DEVELOPMENT_TEAM = 4JV8BHB2KW
DG_PROFILE_Runner = dg com.colex.dshgo
// The share extension (app/ios/ShareExtension): its own App ID and profile, App Group group.com.colex.dshgo.
DG_PROFILE_ShareExtension = dg com.colex.dshgo.share
// The 「鲸游」Live Activity extension (app/ios/WhaleWakeActivity): its own App ID, no capability.
DG_PROFILE_WhaleWakeActivity = dg com.colex.dshgo.activity
// The Notification Service Extension (app/ios/NotificationService): decrypts dg pushes.
DG_PROFILE_NotificationService = dg com.colex.dshgo.notify
PROVISIONING_PROFILE_SPECIFIER = $(DG_PROFILE_$(TARGET_NAME))
